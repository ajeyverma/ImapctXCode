{
  "name": "impactxcode-vscode-extension",
  "displayName": "ImpactXCode",
  "description": "A starter Visual Studio Code extension.",
  "version": "0.0.1",
  "publisher": "SubwayCoders",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ajeyverma/ImpactXCode.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:impactxcode.main",
    "onView:impactxcode.panel",
    "onCommand:impactxcode.generateAiSummary",
    "onCommand:impactxcode.togglePanel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "impactxcode",
          "title": "ImpactXCode",
          "icon": "media/impactxcode.svg"
        }
      ],
      "panel": [
        {
          "id": "impactxcodePanel",
          "title": "ImpactXCode",
          "icon": "media/impactxcode.svg"
        }
      ]
    },
    "views": {
      "impactxcode": [
        {
          "id": "impactxcode.main",
          "name": "Explorer"
        }
      ],
      "impactxcodePanel": [
        {
          "id": "impactxcode.panel",
          "name": "ImpactXCode",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "impactxcode.generateAiSummary",
        "title": "ImpactXCode: Generate AI Summary"
      },
      {
        "command": "impactxcode.togglePanel",
        "title": "ImpactXCode: Toggle Summary, Graph and AI Summary in Editor",
        "icon": "$(preview)"
      }
    ],
    "customEditors": [
      {
        "viewType": "impactxcode.editor",
        "displayName": "ImpactXCode",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "impactxcode.togglePanel",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "impactxcode.togglePanel",
          "when": "view == impactxcode.panel",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check-types": "tsc --noEmit -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@vscode/vsce": "^4.1.1"
  }
}
